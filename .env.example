# Hevy Pro API key. Get it from https://hevy.com/settings?developer
HEVY_API_KEY=

# Shared secret this server checks on every request (Authorization: Bearer <token>).
# Also the value returned as access_token by the OAuth flow below, so it
# doesn't matter which path a client used to get it.
MCP_BEARER_TOKEN=

# Credentials for this server's own minimal OAuth 2.1 authorization server
# (see "Connect to Claude" below for why this exists). OAUTH_CLIENT_SECRET
# is also used as the HMAC signing key for short-lived authorization codes.
# All three of MCP_BEARER_TOKEN, OAUTH_CLIENT_ID, and OAUTH_CLIENT_SECRET
# can be generated deterministically from one memorable master passphrase —
# see the README for the derive() recipe.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Comma-separated allowlist of hosts /api/oauth/authorize is allowed to
# redirect back to. Defaults to "claude.ai,claude.com" if unset — only
# override if Claude's OAuth redirect_uri uses a different domain.
# OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com

# Optional: a Slack or Discord "incoming webhook" URL. When set, every
# authentication failure on this server — bad/missing MCP_BEARER_TOKEN,
# invalid OAuth client_id/client_secret, bad PKCE, or a disallowed
# redirect_uri — is POSTed here as a real-time alert, in addition to always
# being logged as structured JSON to stderr (visible in Vercel's function
# logs even with this unset). Leave unset to log-only.
#
# Slack: create one at https://api.slack.com/messaging/webhooks
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook,
#          then use the "Copy Webhook URL" value directly (Discord accepts
#          the same {"text": "..."} payload shape as Slack).
SECURITY_ALERT_WEBHOOK_URL=
